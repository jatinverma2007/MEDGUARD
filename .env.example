# ---- MedGuard configuration (copy to .env) ----

# Model identifiers (all verified on Hugging Face)
MEDGUARD_OCR_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
MEDGUARD_NER_MODEL=michiyasunaga/BioLinkBERT-base
MEDGUARD_RELATION_MODEL=microsoft/deberta-v3-base

# Optional free LLM for grounded explanations (Groq / Google AI Studio / OpenRouter)
# Leave empty to use the deterministic template explainer only.
MEDGUARD_LLM_API_KEY=
MEDGUARD_LLM_BASE_URL=https://api.groq.com/openai/v1
MEDGUARD_LLM_MODEL=llama-3.3-70b-versatile

# Confidence threshold below which the system abstains / defers to a clinician
MEDGUARD_ABSTAIN_THRESHOLD=0.55

# Language for patient-facing explanations: en | hi
MEDGUARD_DEFAULT_LANGUAGE=en

# Set to "true" to log raw prescription text (PHI) - keep false in production
MEDGUARD_LOG_PHI=false
